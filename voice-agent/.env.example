# LiveKit Cloud credentials (WebRTC room)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Speech-to-Text (STT) & Multi-Provider TTS
DEEPGRAM_API_KEY=

# LLM (Google Gemini)
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Optional TTS Providers
CARTESIA_API_KEY=
BREEZE_API_KEY=

# Google Cloud Text-to-Speech (Service Account credentials path)
GOOGLE_APPLICATION_CREDENTIALS=

# LiveKit Cloud credentials (WebRTC room)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Speech-to-Text (Deepgram Nova-3 / Flux STT)
DEEPGRAM_API_KEY=

# LLM (Google Gemini)
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Text-to-Speech (ElevenLabs Eleven v4 Turbo Multilingual TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_v4_turbo

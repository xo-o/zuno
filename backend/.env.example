# Better Auth
BETTER_AUTH_SECRET= # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000 # public https URL in production; magic links point here

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/zuno

# Resend
RESEND_API_KEY=
EMAIL_FROM="Zuno <hello@heyzuno.app>"

# Google (Google Cloud Console > Credentials)
# The Web client ID is what the Android app passes as serverClientId, so ID tokens are issued for it.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Sign in with Apple (optional; enabled when CLIENT_ID and CLIENT_SECRET are set)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=

# LiveKit (voice sessions; tokens are only issued to signed-in users)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Cartesia (Sonic-3 multilingual TTS for previews and coach sample playback)
CARTESIA_API_KEY=

# Android App Links (served at /.well-known/assetlinks.json)
ANDROID_PACKAGE_NAME=com.zuno.ai
# Comma-separated SHA-256 signing cert fingerprints (debug keystore below; add release/Play signing keys)
ANDROID_SHA256_CERT_FINGERPRINTS=FA:C6:17:45:DC:09:03:78:6F:B9:ED:E6:2A:96:2B:39:9F:73:48:F0:BB:6F:89:9B:83:32:66:75:91:03:3B:9C

# Gemini (topic/roleplay generation, tutor replies, hints)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Cloudflare R2 (chat attachments; the bucket stays private, files are served via signed URLs)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=

# Public origin of this backend, used for shared chat links (/s/:token) and email unsubscribe links
PUBLIC_BASE_URL=https://api.heyzuno.app

# Comma-separated browser origins allowed to call the API (the Android app doesn't need CORS)
CORS_ORIGINS=https://heyzuno.app

# Firebase Admin service account (JSON, raw or base64) for push notifications. Push is off when unset.
FIREBASE_SERVICE_ACCOUNT=

# Optional: inbox that receives an email for every chat report
REPORTS_EMAIL=reports@heyzuno.app

# Background jobs run only when NODE_ENV=production (set by the Dockerfile) or RUN_JOBS=1.
# DISABLE_JOBS=1 turns them off in production.
RUN_JOBS=

# Marketing website (heyzuno.app): base of account-deletion confirm links, and the contact form inbox
WEB_BASE_URL=https://heyzuno.app
SUPPORT_EMAIL=support@heyzuno.app
